DAFTAR_ENVIRONMENT=development
DAFTAR_LOG_LEVEL=info
DAFTAR_LOG_FORMAT=pretty
DAFTAR_LOG_SLOW_REQUEST_THRESHOLD=750ms
DAFTAR_FRONTEND_PORT=3000
DAFTAR_API_PORT=8080
DAFTAR_HTTP_ADDRESS=:8080
DAFTAR_HTTP_READ_HEADER_TIMEOUT=5s
DAFTAR_HTTP_READ_TIMEOUT=15s
DAFTAR_HTTP_WRITE_TIMEOUT=30s
DAFTAR_HTTP_IDLE_TIMEOUT=1m
DAFTAR_HTTP_SHUTDOWN_TIMEOUT=10s
DAFTAR_HTTP_REQUEST_TIMEOUT=1m
DAFTAR_HTTP_MAX_HEADER_BYTES=1048576
DAFTAR_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DAFTAR_RATE_LIMIT_PER_MINUTE=60
DAFTAR_LOGIN_RATE_PER_MINUTE=5
DAFTAR_REGISTER_RATE_PER_MINUTE=3
DAFTAR_TRUSTED_PROXIES=
DAFTAR_ENABLE_HSTS=false
DAFTAR_API_INTERNAL_URL=http://api:8080
DAFTAR_API_INTERNAL_URL_NATIVE=http://localhost:8080

# Default Docker profile: a self-contained single-node MongoDB replica set.
# Production/Atlas deployments should leave COMPOSE_PROFILES empty and replace
# DAFTAR_MONGODB_URI with their secret Atlas connection string.
COMPOSE_PROFILES=local-db
DAFTAR_MONGODB_PORT=27017
DAFTAR_MONGODB_URI=mongodb://mongo:27017/?replicaSet=rs0
DAFTAR_MONGODB_URI_NATIVE=mongodb://localhost:27017/?replicaSet=rs0
DAFTAR_MONGODB_DATABASE=daftar
DAFTAR_MONGODB_CONNECT_TIMEOUT=10s
DAFTAR_MONGODB_SHUTDOWN_TIMEOUT=10s

# Generate a unique high-entropy value of at least 32 characters.
DAFTAR_JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
DAFTAR_JWT_ISSUER=daftar-api
DAFTAR_JWT_AUDIENCE=daftar-web
DAFTAR_JWT_ACCESS_TTL=15m
DAFTAR_JWT_REFRESH_TTL=720h

DAFTAR_COOKIE_NAME=daftar_session
DAFTAR_REFRESH_COOKIE_NAME=daftar_refresh
DAFTAR_COOKIE_DOMAIN=
DAFTAR_COOKIE_PATH=/
DAFTAR_COOKIE_SECURE=false
DAFTAR_COOKIE_SAME_SITE=lax

# Local reviewer seed account. Override every value before seeding a public environment.
DAFTAR_BOOTSTRAP_USER_ENABLED=false
DAFTAR_BOOTSTRAP_USER_EMAIL=reviewer@daftar.local
DAFTAR_BOOTSTRAP_USER_PASSWORD=DaftarDemo2026!
DAFTAR_BOOTSTRAP_USER_FIRST_NAME=Ada
DAFTAR_BOOTSTRAP_USER_LAST_NAME=Reviewer
